# Regeneratable from data/raw -- don't commit. data/raw/*.json and
# data/norm_stats.npz ARE committed (small, self-generated, no external
# download source -- see CLAUDE.md for why this deviates from the AirfRANS
# project's blanket data/ gitignore).
data/cache/
data/runs/
data/*.ckpt
# Deliberate, narrow exception: the one demo/release checkpoint (see
# src/app.py, CLAUDE.md) -- small (~2.5MB), needed for the demo to work on
# a machine that hasn't trained anything. Not a general "commit checkpoints"
# policy change -- every other .ckpt stays gitignored.
!data/model_release.ckpt

__pycache__/
*.pyc

# Abaqus scripting-kernel session artifacts (abaqus cae / abaqus python)
*.rpy
*.rpy.*
*.rec
abaqus_acis.log
abaqusis.env
